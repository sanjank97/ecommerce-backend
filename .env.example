# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas) — apna connection string yahan daalo
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/ecommerce?appName=Cluster0

# JWT
JWT_SECRET=apna_strong_secret_yahan_daalo
JWT_EXPIRE=7d

# Frontend URL (CORS ke liye)
CLIENT_URL=http://localhost:5173
