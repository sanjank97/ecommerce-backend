{
	"info": {
		"_postman_id": "e1c2a9f0-ecom-cart-api-2026",
		"name": "Ecommerce Backend — Cart API",
		"description": "Cart + Orders testing collection.\n\nFlow:\n1. Health check karo\n2. Register ya Login karo (token automatically capture hota hai)\n3. Products list se productId automatically capture hota hai\n4. Cart endpoints test karo\n5. Orders: Checkout (cart se order banao) → history → cancel → admin flows\n\nToken collection variable {{token}} me save hota hai. Admin flows ke liye pehle 'Register Admin'/'Login Admin' chalao.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminEmail",
			"value": "admin@test.com",
			"type": "string"
		},
		{
			"key": "adminPassword",
			"value": "admin123",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/"
			}
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"User registered (201)\", () => pm.expect(pm.response.code).to.eql(201));",
									"const json = pm.response.json();",
									"if (json && json.data && json.data.token) {",
									"    pm.collectionVariables.set(\"token\", json.data.token);",
									"    console.log(\"Token captured ✅\");",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser1@test.com\",\n  \"password\": \"test123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/register"
					}
				},
				{
					"name": "Register Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.data && json.data.token) {",
									"    pm.collectionVariables.set(\"token\", json.data.token);",
									"    console.log(\"Admin token captured ✅\");",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"role\": \"admin\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/register"
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Login success (200)\", () => pm.expect(pm.response.code).to.eql(200));",
									"const json = pm.response.json();",
									"if (json && json.data && json.data.token) {",
									"    pm.collectionVariables.set(\"token\", json.data.token);",
									"    console.log(\"Token captured ✅\");",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser1@test.com\",\n  \"password\": \"test123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.data && json.data.token) {",
									"    pm.collectionVariables.set(\"token\", json.data.token);",
									"    console.log(\"Admin token captured ✅\");",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "Get Me",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/auth/me"
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get All Products (captures productId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.data && json.data.length > 0) {",
									"    pm.collectionVariables.set(\"productId\", json.data[0]._id);",
									"    console.log(\"productId captured ✅ =>\", json.data[0]._id, \"(\" + json.data[0].name + \")\");",
									"} else {",
									"    console.log(\"⚠️ Koi product nahi mila — pehle 'Create Product (Admin)' chalao\");",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": "{{baseUrl}}/api/products"
					}
				},
				{
					"name": "Create Product (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"price\": 799,\n  \"category\": \"electronics\",\n  \"description\": \"Ergonomic 2.4GHz wireless mouse\"\n}"
						},
						"url": "{{baseUrl}}/api/products"
					}
				}
			]
		},
		{
			"name": "Cart",
			"item": [
				{
					"name": "Get My Cart",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/cart"
					}
				},
				{
					"name": "Add to Cart",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
						},
						"url": "{{baseUrl}}/api/cart"
					}
				},
				{
					"name": "Add to Cart — No Body (validation check ❌)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": "{{baseUrl}}/api/cart"
					}
				},
				{
					"name": "Add to Cart — quantity 0 (validation check ❌)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 0\n}"
						},
						"url": "{{baseUrl}}/api/cart"
					}
				},
				{
					"name": "Add to Cart — Invalid productId (404 check ❌)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"aaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"quantity\": 1\n}"
						},
						"url": "{{baseUrl}}/api/cart"
					}
				},
				{
					"name": "Remove Item from Cart",
					"request": {
						"method": "DELETE",
						"url": "{{baseUrl}}/api/cart/{{productId}}"
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"url": "{{baseUrl}}/api/cart"
					}
				},
				{
					"name": "Cart without Token (401 check ❌)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": "{{baseUrl}}/api/cart"
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Checkout — Create Order (from cart)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Order created (201)\", () => pm.expect(pm.response.code).to.eql(201));",
									"const json = pm.response.json();",
									"if (json && json.data && json.data._id) {",
									"    pm.collectionVariables.set(\"orderId\", json.data._id);",
									"    console.log(\"orderId captured ✅ =>\", json.data._id, \"| orderNumber:\", json.data.orderNumber, \"| total:\", json.data.totalAmount);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Test User\",\n    \"phone\": \"9876543210\",\n    \"street\": \"123 Main Street, Sector 12\",\n    \"city\": \"Panipat\",\n    \"state\": \"Haryana\",\n    \"zipCode\": \"132103\",\n    \"country\": \"India\"\n  },\n  \"paymentMethod\": \"COD\"\n}"
						},
						"url": "{{baseUrl}}/api/orders"
					}
				},
				{
					"name": "Checkout — Empty Cart (400 check ❌)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"shippingAddress\": {\"fullName\": \"Test User\", \"phone\": \"9876543210\", \"street\": \"123 Main Street\", \"city\": \"Panipat\", \"state\": \"Haryana\", \"zipCode\": \"132103\"}}"
						},
						"url": "{{baseUrl}}/api/orders"
					}
				},
				{
					"name": "Checkout — Invalid Address (400 check ❌)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"shippingAddress\": {\"fullName\": \"T\", \"phone\": \"123\", \"street\": \"ab\", \"city\": \"\", \"state\": \"\", \"zipCode\": \"12\"}}"
						},
						"url": "{{baseUrl}}/api/orders"
					}
				},
				{
					"name": "Get My Orders (history)",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/orders/my-orders?page=1&limit=10"
					}
				},
				{
					"name": "Get Order By Id",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/orders/{{orderId}}"
					}
				},
				{
					"name": "Get Order By Id — No Token (401 check ❌)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": "{{baseUrl}}/api/orders/{{orderId}}"
					}
				},
				{
					"name": "Cancel Order",
					"request": {
						"method": "PUT",
						"url": "{{baseUrl}}/api/orders/{{orderId}}/cancel"
					}
				},
				{
					"name": "ADMIN: Get All Orders",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/orders?page=1&limit=10"
					}
				},
				{
					"name": "ADMIN: Get All Orders (status filter)",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/orders?status=pending"
					}
				},
				{
					"name": "ADMIN: Update Order Status (confirmed)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status updated (200)\", () => pm.expect(pm.response.code).to.eql(200));",
									"const json = pm.response.json();",
									"if (json && json.data) console.log(\"orderStatus:\", json.data.orderStatus, \"| paymentStatus:\", json.data.paymentStatus);"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"orderStatus\": \"confirmed\"}"
						},
						"url": "{{baseUrl}}/api/orders/{{orderId}}/status"
					}
				},
				{
					"name": "ADMIN: Update Order Status → shipped",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"orderStatus\": \"shipped\"}"
						},
						"url": "{{baseUrl}}/api/orders/{{orderId}}/status"
					}
				},
				{
					"name": "ADMIN: Update Order Status → delivered (COD ⇒ paid)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.data) {",
									"    pm.test(\"COD delivered ⇒ paymentStatus paid\", () => pm.expect(json.data.paymentStatus).to.eql(\"paid\"));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"orderStatus\": \"delivered\"}"
						},
						"url": "{{baseUrl}}/api/orders/{{orderId}}/status"
					}
				},
				{
					"name": "Cancel Delivered Order (400 check ❌)",
					"request": {
						"method": "PUT",
						"url": "{{baseUrl}}/api/orders/{{orderId}}/cancel"
					}
				}
			]
		}
	]
}